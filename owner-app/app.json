{
  "expo": {
    "owner": "invictus_build",
    "name": "Schezwan Delight",
    "slug": "owner-app",
    "version": "1.0.0",
    "scheme": "owner-app",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.schezwandelight.ownerapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FEFBEF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png",
      "name": "Schezwan Delight",
      "shortName": "Sz Delight",
      "display": "standalone",
      "backgroundColor": "#FEFBEF",
      "themeColor": "#B82A2B"
    },
    "extra": {
      "eas": {
        "projectId": "156069c3-a953-4767-b47e-1c5a9430a137"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "backgroundColor": "#FEFBEF",
          "imageWidth": 200
        }
      ],
      "expo-build-properties"
    ]
  }
}
